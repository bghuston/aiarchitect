{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "aggregate",
    "input",
    "transactional"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]*$"
    },
    "aggregate": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]*$"
    },
    "input": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$",
            "not": {
              "enum": [
                "class",
                "function",
                "return",
                "var",
                "let",
                "const",
                "new",
                "default",
                "export",
                "import",
                "extends",
                "implements",
                "interface",
                "type",
                "null",
                "true",
                "false",
                "this",
                "super",
                "delete",
                "constructor",
                "__proto__",
                "prototype"
              ]
            }
          },
          "type": {
            "enum": [
              "string",
              "number",
              "boolean",
              "datetime"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "transactional": {
      "type": "boolean"
    }
  }
}
